#include <stdio.h>

int main()
{
    int n, x;
    int arr[100];
    int low, high, mid;
    int ans = -1;

    // Input size of array
    scanf("%d", &n);

    // Input sorted array
    for (int i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    // Input x
    scanf("%d", &x);

    low = 0;
    high = n - 1;

    // Binary search for ceil of x
    while (low <= high)
    {
        mid = (low + high) / 2;

        if (arr[mid] >= x)
        {
            ans = mid;
            high = mid - 1;  // Search left for first occurrence
        }
        else
        {
            low = mid + 1;
        }
    }

    printf("%d", ans);

    return 0;
}
